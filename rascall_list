#!/usr/bin/env python3
"""
Plot a functional group, one plot per bond in the database, or filter and list 
molecules based on atmospheric windows and instrument wavelength range.
"""
from typing import Tuple, Optional, List
from argparse import ArgumentParser
import logging
from pathlib import Path

from rascall import database, molecule_filter
from rascall.atmospheric_windows import ATMOSPHERIC_WINDOWS

logger = logging.getLogger(__name__)

def parse_wavelength_range(range_str: str) -> Tuple[float, float]:
    """Parse wavelength range string into start and end values."""
    try:
        start, end = map(float, range_str.split('-'))
        return start, end
    except ValueError as e:
        logger.error(f"Invalid wavelength range format: {range_str}")
        raise ValueError(f"Wavelength range must be in format 'start-end': {e}")

def setup_argparser() -> ArgumentParser:
    """Set up command line argument parser."""
    parser = ArgumentParser(description=__doc__)
    parser.add_argument('--fg', help='Functional group to plot')
    parser.add_argument('--mol', help='Single molecule to plot')
    parser.add_argument('--mf', help='Molecule family to plot')
    parser.add_argument('--fw', help='Filter by wavelength range (format: start-end)')
    parser.add_argument('--ap', help='Atmospheric profile to use')
    parser.add_argument('--aw', help='Atmospheric window to use', 
                       choices=list(ATMOSPHERIC_WINDOWS.keys()))
    parser.add_argument('--atmosphere', help='Filter by atmospheric window',
                       choices=list(ATMOSPHERIC_WINDOWS.keys()))
    parser.add_argument('--wavelength', type=parse_wavelength_range,
                       help='Filter by wavelength range (format: start-end)')
    parser.add_argument('--strong-threshold', type=float, default=0.5,
                       help='Threshold for strong features')
    parser.add_argument('--multiple-threshold', type=int, default=2,
                       help='Minimum number of strong features')
    return parser

def process_existing_functionality(args: ArgumentParser) -> None:
    """Handle existing plotting functionality."""
    results = database.plot(args.fg, args.mf, args.mol, args.aw)
    if results is None:
        logger.warning("No results found.")
    else:
        for result in results:
            logger.info(result)

def process_new_functionality(args: ArgumentParser) -> None:
    """Handle new filtering functionality."""
    filtered_molecules: List[str] = []
    
    if args.atmosphere:
        filtered_molecules = molecule_filter.filter_for_atmospheric_window(args.atmosphere)
    elif args.wavelength:
        start, end = args.wavelength
        filtered_molecules = molecule_filter.filter_for_wavelength_range(start, end)

    strong_molecules = molecule_filter.filter_for_intensity(
        args.strong_threshold, filtered_molecules
    )
    
    multiple_strong_molecules = molecule_filter.filter_for_multiple_strong_features(
        args.strong_threshold, args.multiple_threshold, filtered_molecules
    )

    logger.info(f"Found {len(filtered_molecules)} molecules")
    logger.info(f"Found {len(strong_molecules)} molecules with strong features")
    logger.info(f"Found {len(multiple_strong_molecules)} molecules with multiple strong features")

def main() -> None:
    """Main entry point."""
    logging.basicConfig(
        level=logging.INFO,
        format='%(asctime)s - %(name)s - %(levelname)s - %(message)s'
    )
    
    parser = setup_argparser()
    args = parser.parse_args()

    try:
        if any([args.fg, args.mol, args.mf, args.fw, args.ap, args.aw]):
            process_existing_functionality(args)
        elif args.atmosphere or args.wavelength:
            process_new_functionality(args)
        else:
            parser.print_help()
    except Exception as e:
        logger.error(f"An error occurred: {e}")
        raise SystemExit(1)

if __name__ == "__main__":
    main()


